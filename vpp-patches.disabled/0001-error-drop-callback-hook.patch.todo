From: pcap_stream-plugin <noreply@anthropic.com>
Subject: [PATCH] error-drop: add per-buffer callback hook for capture plugins

Adds vlib_drop_callback_register() / _unregister() so plugins can
observe packets right before they're freed by the error-drop node.
The callback receives (vlib_main, buffer, error_index) — same context
the node has at free time.

Used by the pcap_stream plugin to capture dropped packets in `-d drop`
mode. The capture plugin must complete its per-buffer work
synchronously (the buffer is freed immediately after the callback
returns) and must not modify the buffer.

Generally useful — anyone wanting to observe drops (sFlow on the
drop path, IPFIX export, debugging tools) can register without
having to wrap or replace error-drop.
---
--- a/src/vlib/drop.c
+++ b/src/vlib/drop.c
@@ -28,6 +28,40 @@
 #include <vlib/vlib.h>
 #include <vlib/unix/unix.h>

+/* Vector of registered drop callbacks. Each is invoked for every
+ * buffer that hits error-drop, before the buffer is returned to
+ * the buffer pool. Callbacks must be cheap (this runs in worker
+ * context on the hot path) and must not modify the buffer. */
+static vlib_drop_callback_fn_t *vlib_drop_callbacks;
+
+void
+vlib_drop_callback_register (vlib_drop_callback_fn_t fn)
+{
+  vlib_drop_callback_fn_t *cb;
+  vec_foreach (cb, vlib_drop_callbacks)
+    {
+      if (*cb == fn)
+        return;
+    }
+  vec_add1 (vlib_drop_callbacks, fn);
+}
+
+void
+vlib_drop_callback_unregister (vlib_drop_callback_fn_t fn)
+{
+  vlib_drop_callback_fn_t *cb;
+  for (uword i = 0; i < vec_len (vlib_drop_callbacks); i++)
+    {
+      if (vlib_drop_callbacks[i] == fn)
+        {
+          vec_del1 (vlib_drop_callbacks, i);
+          break;
+        }
+    }
+}
+
+/* --- error-drop graph node --- */
+
 typedef enum
 {
   ERROR_DISPOSITION_DROP,
@@ -126,6 +160,18 @@ process_drop_punt (vlib_main_t * vm,
       u64 e0 = b0->error;

       counter_index = vlib_error_get_code (&node->errors_heap_index, e0);
+
+      /* Invoke registered drop callbacks before freeing — the
+       * pcap_stream plugin uses this to capture dropped packets
+       * for the operator's `-d drop` mode. Cheap when the vec is
+       * empty (the common case). */
+      if (PREDICT_FALSE (vec_len (vlib_drop_callbacks) > 0 &&
+                         disposition == ERROR_DISPOSITION_DROP))
+        {
+          vlib_drop_callback_fn_t *cb;
+          vec_foreach (cb, vlib_drop_callbacks)
+            (*cb) (vm, b0, e0);
+        }
       counter_index += vlib_error_get_node (&node->errors_heap_index, e0);

       em->counters[counter_index] += 1;
--- a/src/vlib/vlib.h
+++ b/src/vlib/vlib.h
@@ -52,6 +52,15 @@
 #include <vlib/init.h>
 #include <vlib/error.h>
 #include <vlib/error_funcs.h>
+
+/* Drop-callback hook (see drop.c). Allows plugins to observe
+ * packets immediately before error-drop frees them. The buffer
+ * MUST NOT be modified. e0 is the encoded error (node << 16 | code). */
+typedef void (*vlib_drop_callback_fn_t) (struct vlib_main_t *vm,
+                                         struct vlib_buffer_t *b, u64 e0);
+void vlib_drop_callback_register (vlib_drop_callback_fn_t fn);
+void vlib_drop_callback_unregister (vlib_drop_callback_fn_t fn);
+
 #include <vlib/lex.h>
 #include <vlib/pci/pci.h>
 #include <vlib/global_funcs.h>
